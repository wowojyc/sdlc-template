{
  "_说明": [
    "Qoder 的 hooks + permissions 配置示例（已在 Qoder CN IDE 实测）。",
    "放置位置（二选一，按你用的产品线）：",
    "  · Qoder CLI：~/.qoder/settings.json（用户级）或 .qoder/settings.json（项目级，可提交 git 团队共享）",
    "  · QoderWork CN：~/.qoderwork/settings.json（用户级）",
    "注意：",
    "  · 当前版本不支持热加载，改完配置需要重启 Qoder 才生效",
    "  · command 以 ${project} 开头会走 IDE 内置 git-bash 执行；${project} 本身不会展开，",
    "    因此命令内容必须自足（用相对路径，cwd 即项目根目录），不要依赖 ${project} 展开",
    "  · 脚本用 Python 标准库解析 stdin JSON，无需安装 jq"
  ],

  "permissions": {
    "_说明": "决策三态：allow 放行 / ask 询问（需人确认）/ deny 拒绝。headless(-p) 模式下 ask 会自动变成 deny。",
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(deploy:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${project} python .qoder/hooks/block-dangerous.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${project} python .qoder/hooks/protect-tests.py",
            "timeout": 10
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${project} python .qoder/hooks/auto-lint.py",
            "timeout": 60
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${project} python .qoder/hooks/verify-before-stop.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
